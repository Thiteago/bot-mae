DISCORD_BOT_TOKEN=
DISCORD_BOT_CLIENT_ID=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube Data API v3 key (console.cloud.google.com), used to search/resolve videos.
YOUTUBE_API_KEY=

# Only needed when running outside docker compose (defaults to the value below).
REDIS_URL=redis://localhost:6379/1

# Opcional: caminho pro arquivo de cookies (formato Netscape) usado pelo yt-dlp,
# necessário se o YouTube passar a bloquear o IP do bot com "Sign in to confirm
# you're not a bot" / 429. Ver README para como gerar. Sem docker, aponte pro
# caminho local do arquivo; com docker, é preenchido automaticamente pelo
# docker-compose.yml (não precisa setar aqui).
# YTDLP_COOKIES_FILE=./cookies.txt

# Opcional: notificação por DM no Discord quando um pedido do Seerr é aprovado
# ou fica disponível. Se não setar SEER_WEBHOOK_SECRET, essa feature fica
# desligada (nenhum servidor webhook sobe). Ver README para como configurar
# o lado do Seerr (Settings > Notifications > Webhook).
# SEER_WEBHOOK_SECRET=
# SEER_WEBHOOK_PORT=8090
